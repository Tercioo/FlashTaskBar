        "content": "Securely sandbox a unit frame event handler by assigning it a restricted environment with DF:SetEnvironment"
    },
    {
        "role": "assistant",
        "content": "local eventHandler = function(event, arg1, arg2)\n    if event == \"UNIT_HEALTH\" then\n        print(\"Health changed for \" .. arg1)\n    end\nend\nlocal restrictedEnv = { print = print }\nlocal handle = CreateFrame(\"Frame\"):GetScript(\"OnLoad\")\nDF:SetEnvironment(eventHandler, handle, restrictedEnv)"
    }
]}

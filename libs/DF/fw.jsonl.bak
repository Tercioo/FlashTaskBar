            "content": "if SettingsPanel then\n    local cat = SettingsPanel:GetCategoryList():GetCategory(self.OptionsFrame1.name)\n    if cat then\n        SettingsPanel:Open()\n        SettingsPanel:SelectCategory(cat)\n        if self.OptionsFrame2 then\n            for _, sub in pairs(cat:GetSubcategories()) do\n                if sub:GetName() == self.OptionsFrame2.name then\n                    SettingsPanel:SelectCategory(sub)\n                    break\n                end\n            end\n        end\n        return\n    end\nend\n-- fallback\nInterfaceOptionsFrame_OpenToCategory(self.__name)\nfor i = 1, 100 do\n    local btn = _G[\"InterfaceOptionsFrameAddOnsButton\" .. i]\n    if not btn then break end\n    local txt = _G[\"InterfaceOptionsFrameAddOnsButton\" .. i .. \"Text\"]\n    if txt and txt:GetText() == self.__name then\n        local toggle = _G[\"InterfaceOptionsFrameAddOnsButton\" .. i .. \"Toggle\"]\n        if toggle and toggle:GetNormalTexture():GetTexture():find(\"PlusButton\") then\n            toggle:Click()\n        end\n        _G[\"InterfaceOptionsFrameAddOnsButton\" .. i + 1]:Click()\n        break\n    end\nend"
